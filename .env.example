DATABASE_URL=postgresql+psycopg2://mise:mise_dev_pw@localhost:5432/mise_dev
ENVIRONMENT=development

# Auth (Epic 1 step 4). The default below is intentionally insecure and only
# works because ENVIRONMENT != production — see app/core/config.py, which
# refuses to start in production with this default value.
JWT_SECRET=dev-insecure-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAGIC_LINK_EXPIRE_MINUTES=15
